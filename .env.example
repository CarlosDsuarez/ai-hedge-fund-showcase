# ── Offline demo (no keys needed) ────────────────────────────────────────
# DATA_MODE=synthetic   → seeded synthetic prices/fundamentals/headlines (data/synthetic.py)
# LLM_MODE=stub         → deterministic stand-in for the Anthropic API (utils/llm.py)
# ALERTS_MODE=console   → print alerts instead of sending them to Telegram
DATA_MODE=synthetic
LLM_MODE=stub
ALERTS_MODE=console

# ── Live services (optional) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Alpaca — PAPER account only. Broker calls fail closed unless PAPER_TRADING=true.
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here
PAPER_TRADING=true

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Additional midday run in scheduler.py
MIDDAY_RUN=false
